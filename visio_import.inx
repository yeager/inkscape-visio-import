<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Visio Import</name>
    <id>org.inkscape.input.visio_import</id>
    <param name="page" type="int" min="0" max="100" gui-text="Page number (0-based):">0</param>
    <input>
        <extension>.vsdx</extension>
        <mimetype>application/vnd.ms-visio.drawing.main+xml</mimetype>
        <filetypename>Microsoft Visio Drawing (*.vsdx)</filetypename>
        <filetypetooltip>Import Microsoft Visio 2013+ XML Drawing</filetypetooltip>
    </input>
    <script>
        <command location="inx" interpreter="python">visio_import.py</command>
    </script>
</inkscape-extension>
